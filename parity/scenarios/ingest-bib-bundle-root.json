{
  "name": "ingest-bib-bundle-root",
  "settings": {
    "db_path": "parity/out/ingest-bib-bundle-root-@RUNNER@.db",
    "embedding_dim": 512,
    "model_id": "google/embeddinggemma-2",
    "device": "cuda",
    "precision": "auto",
    "bundle_root": "parity/corpus/empty"
  },
  "setup": {
    "import": {
      "corpus": "parity/corpus/empty"
    }
  },
  "ops": [
    {
      "op": "ingest",
      "params": {
        "kind": "bib",
        "bib_path": "parity/fixtures/parity.bib"
      }
    },
    {
      "op": "get_by_id",
      "params": {
        "concept_id": "refs/alpha2020"
      }
    }
  ]
}
