{
  "name": "bibtex-sparse-entry",
  "settings": {
    "db_path": "parity/out/bibtex-sparse-@RUNNER@.db",
    "embedding_dim": 512,
    "model_id": "google/embeddinggemma-2",
    "device": "cuda",
    "precision": "auto"
  },
  "setup": {"import": {"corpus": "parity/corpus/empty"}},
  "ops": [
    {
      "op": "ingest",
      "params": {"kind": "bib", "bib_path": "parity/fixtures/sparse.bib"}
    },
    {"op": "get_by_id", "params": {"concept_id": "refs/onlytitle"}},
    {"op": "get_by_id", "params": {"concept_id": "refs/onlykey"}}
  ]
}
