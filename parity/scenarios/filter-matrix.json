{
  "name": "filter-matrix",
  "settings": {
    "db_path": "parity/fixtures/oracle-v10-filters.db",
    "embedding_dim": 512,
    "model_id": "google/embeddinggemma-2",
    "device": "cuda",
    "precision": "auto",
    "enable_chunking": true,
    "chunk_size": 32,
    "chunk_overlap": 4,
    "exclude_tags": ["drop"]
  },
  "setup": {"fixture": "parity/fixtures/oracle-v10-filters.db"},
  "ops": [
    {"op": "search", "params": {"query": "badger", "limit": 10}},
    {"op": "search", "params": {"query": "badger", "limit": 10, "concept_type": "article"}},
    {"op": "search", "params": {"query": "badger", "limit": 10, "tags": ["parity"]}},
    {"op": "search", "params": {"query": "badger", "limit": 10, "tags": ["keep"]}},
    {"op": "search", "params": {"query": "badger", "limit": 10, "parent_id": "area1"}},
    {"op": "search", "params": {"query": "badger", "limit": 10, "where": {"owner": "team-a"}}},
    {"op": "search", "params": {"query": "badger", "limit": 10, "where": {"status": "active"}}},
    {"op": "search", "params": {"query": "badger", "limit": 10, "where": {"owner": "team-a", "status": "active"}}},
    {"op": "search", "params": {"query": "badger", "limit": 10, "since": "2026-03-01"}},
    {"op": "search", "params": {"query": "badger", "limit": 10, "until": "2026-04-01"}},
    {"op": "search", "params": {"query": "badger", "limit": 10, "tags": ["drop"], "exclude_tags": []}},
    {"op": "search", "params": {"query": "badger", "limit": 10, "exclude_tags": ["keep"]}},
    {"op": "search", "params": {"query": "badger", "limit": 10, "near_id": "area1/alpha", "hops": 1}},
    {"op": "search", "params": {"query": "badger", "limit": 10, "near_id": "area1/alpha", "hops": 2}},
    {"op": "search", "params": {"query": "badger", "limit": 3, "offset": 2}},
    {"op": "search", "params": {"query": "badger", "limit": 10, "efs": 64}},
    {"op": "search", "params": {"query": "badger", "limit": 10, "rank": "hub", "hub_weight": 0.5}},
    {"op": "search", "params": {"query": "badger", "limit": 10, "rank": "hub", "link_kinds": ["mention"]}},
    {"op": "search", "params": {"query": "badger", "limit": 10, "rank": "hub", "link_kinds": ["tag"]}},
    {"op": "search", "params": {"query": "badger", "limit": 10, "target": "chunks"}},
    {"op": "search", "params": {"query": "badger", "limit": 10, "target": "chunks", "concept_type": "note"}},
    {"op": "search", "params": {"query": "badger", "limit": 10, "target": "chunks", "tags": ["keep"]}},
    {"op": "search", "params": {"query": "badger", "limit": 10, "target": "chunks", "parent_id": "area1/alpha"}},
    {"op": "search", "params": {"query": "badger", "limit": 10, "target": "chunks", "where": {"owner": "team-a"}}},
    {"op": "search", "params": {"query": "badger", "limit": 10, "target": "chunks", "since": "2026-04-01"}},
    {"op": "search", "params": {"query": "badger", "limit": 10, "target": "chunks", "until": "2026-03-01"}},
    {"op": "search", "params": {"query": "badger", "limit": 10, "target": "chunks", "tags": ["drop"], "exclude_tags": []}},
    {"op": "search", "params": {"query": "badger", "limit": 10, "target": "chunks", "near_id": "area1/alpha", "hops": 1}},
    {"op": "search", "params": {"query": "badger", "limit": 10, "target": "chunks", "near_id": "area1/alpha", "hops": 2}},
    {"op": "search", "params": {"query": "badger", "limit": 10, "target": "chunks", "max_chunks_per_doc": 1}},
    {"op": "search", "params": {"query": "badger", "limit": 10, "target": "chunks", "dedupe": true}},
    {"op": "search", "params": {"query": "badger", "limit": 10, "target": "chunks", "offset": 2}},
    {"op": "search", "params": {"query": "badger", "limit": 10, "target": "chunks", "efs": 64}},
    {"op": "search", "params": {"query": "badger", "limit": 10, "target": "chunks", "hub_rerank": true, "hub_weight": 0.5}},
    {"op": "search", "params": {"query": "badger", "limit": 10, "target": "chunks", "hub_rerank": true, "dedupe": true}},
    {"op": "search", "params": {"query": "badger", "limit": 10, "target": "chunks", "hub_rerank": true, "efs": 64}},
    {"op": "search", "params": {"query": "badger", "limit": 10, "target": "chunks", "hub_rerank": true, "rerank": true}}
  ]
}
