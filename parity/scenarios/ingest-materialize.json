{
  "name": "ingest-materialize",
  "settings": {
    "db_path": "parity/out/ingest-materialize-@RUNNER@.db",
    "bundle_root": "parity/out/materialize-@RUNNER@",
    "embedding_dim": 512,
    "model_id": "google/embeddinggemma-2",
    "device": "cuda",
    "precision": "auto"
  },
  "setup": {
    "import": {
      "corpus": "parity/corpus/empty"
    }
  },
  "ops": [
    {
      "op": "ingest",
      "params": {
        "kind": "md",
        "md_path": "parity/corpus/minimal/alpha.md",
        "materialize": true
      }
    },
    {
      "op": "get_by_id",
      "params": {
        "concept_id": "alpha"
      }
    }
  ]
}
