{
  "name": "import-multi-root",
  "settings": {
    "db_path": "parity/out/import-multi-root-@RUNNER@.db",
    "bundle_root": "parity/corpus/multi-root/primary",
    "roots": {"other": "parity/corpus/multi-root/other"},
    "embedding_dim": 512,
    "model_id": "google/embeddinggemma-2",
    "device": "cuda",
    "precision": "auto",
    "enable_chunking": true,
    "chunk_size": 512,
    "chunk_overlap": 40
  },
  "setup": {"import": {"corpus": "parity/corpus/multi-root/primary"}},
  "ops": [
    {"op": "import_bundle", "params": {}},
    {"op": "get_by_id", "params": {"concept_id": "alpha"}},
    {"op": "get_by_id", "params": {"concept_id": "@other/alpha"}},
    {"op": "list_directory", "params": {"directory_id": ""}},
    {"op": "search", "params": {"query": "named root", "limit": 5}}
  ]
}
