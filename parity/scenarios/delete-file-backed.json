{
  "name": "delete-file-backed",
  "settings": {
    "db_path": "parity/out/delete-file-backed.db",
    "bundle_root": "parity/corpus/delete-shared",
    "embedding_dim": 512,
    "model_id": "google/embeddinggemma-2",
    "device": "cuda",
    "precision": "auto",
    "enable_chunking": false
  },
  "setup": {
    "import": {
      "corpus": "parity/corpus/delete-shared"
    }
  },
  "ops": [
    {
      "op": "delete",
      "params": {
        "concept_id": "alpha"
      }
    },
    {
      "op": "delete",
      "params": {
        "concept_id": "alpha",
        "remove_file": true
      }
    },
    {
      "op": "list_deleted",
      "params": {}
    },
    {
      "op": "recover_deleted",
      "params": {
        "concept_id": "alpha"
      }
    },
    {
      "op": "get_by_id",
      "params": {
        "concept_id": "alpha"
      }
    }
  ]
}
