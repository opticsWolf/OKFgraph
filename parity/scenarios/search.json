{
  "name": "search",
  "settings": {
    "db_path": "parity/fixtures/oracle-v10-gpu.db",
    "embedding_dim": 512,
    "model_id": "google/embeddinggemma-2",
    "device": "cuda",
    "precision": "auto",
    "enable_chunking": true,
    "chunk_size": 512,
    "chunk_overlap": 40
  },
  "setup": {"fixture": "parity/fixtures/oracle-v10-gpu.db"},
  "ops": [
    {"op": "search", "params": {"query": "badger diet", "limit": 5}},
    {"op": "search", "params": {"query": "alpha links", "limit": 5}},
    {"op": "search", "params": {"query": "beta body", "limit": 5}},
    {"op": "search", "params": {"query": "alpha links", "limit": 5, "rank": "hub", "hub_weight": 0.3}},
    {"op": "search", "params": {"query": "alpha links", "limit": 5, "rank": "ppr"}},
    {"op": "search", "params": {"query": "alpha links", "limit": 5, "target": "chunks"}},
    {"op": "search", "params": {"query": "alpha links", "limit": 5, "rank": "cross"}},
    {"op": "search", "params": {"query": "alpha links", "limit": 5, "target": "chunks", "rerank": true}},
    {"op": "search", "params": {"query": "alpha links", "limit": 5, "include_chunks": true}},
    {"op": "embed", "params": {"texts": ["badger diet"], "task": "Query"}},
    {"op": "read", "params": {"concept_id": "alpha", "include": "chunks"}},
    {"op": "read", "params": {"concept_id": "alpha", "include": "document"}},
    {"op": "read", "params": {"concept_id": "alpha", "include": "context"}},
    {"op": "traverse", "params": {"start_id": "alpha", "relationship": "LINKS_TO", "direction": "BOTH", "depth": 2}},
    {"op": "lanes", "params": {}}
  ]
}
