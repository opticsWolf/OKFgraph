# Local config pin — copy to `okfgraph.toml` (untracked, gitignored) to use it.
#
# Why a copy, not the file itself: `okfgraph.toml` is looked up CWD-first,
# so a repo-root copy silently re-pins the working database for every CLI
# run and pytest invocation from here. Keeping the live file untracked
# makes the pin a deliberate local choice, documented by this example.
#
# Without any TOML the built-ins apply (0.12.0): db_path =
# ".okfgraph/okfgraph.db", bundle_root = ".okfgraph/bundle" — a CWD with
# a legacy okfgraph.db and no .okfgraph/ keeps that db and bundle root ".".
# Overridable per-invocation with OKFGRAPH_DB_PATH / OKFGRAPH_BUNDLE_ROOT.

bundle_root = "."

[database]
db_path = "kb.db"

# 0.11.0 options (all optional):
#
# extension_dir = "~/.local/share/okfgraph/extensions/0.21.0/linux_amd64"
#     Load Ladybug's vector/fts extensions from here and never download
#     (offline machines). Fill it with `okf setup extensions`.

[import]
# identity = "frontmatter"   # a frontmatter `id:` is the concept id (moves keep links)

[embedding]
# 0.12 external-lane options (the embroider crate stays the default):
# backend = "external"          # an OpenAI-shaped POST /embeddings host owns the model
# endpoint_url = "http://127.0.0.1:8931"
# embed_family = "nomic-v1.5"   # declared contract: prefixes, pooling, dim ladder
# api_key_env = "MY_KEY_VAR"    # name of the env var holding the bearer key
# Counting ladder (batch budgets): embed_counter = "server-tokenize" asks the
# host's POST /tokenize for exact counts (llama.cpp serves it; LM Studio/TEI
# do not — a failed probe degrades loudly); "gguf-meta" + embed_counter_gguf
# = "path/model.gguf" reads a chars/token prior from the GGUF header (pure
# Python, no tokenizer wheel); "declared" + embed_chars_per_token = 3.8 is
# your own constant; default "heuristic" = len/4, logged once as approximate.

[search]
# exclude_tags = ["superseded"]   # hidden unless a search passes exclude_tags
# Cross-encoder for opt-in rerank (search --rerank / --rank cross):
# rerank_model_id = "cross-encoder/mmarco-mMiniLMv2-L12-H384-v1"   # English-only, smaller: cross-encoder/ms-marco-MiniLM-L-6-v2
# rerank_precision = "auto"   # auto (= fp32) | fp32 | q8
# rerank_top_n = 30           # candidates rescored per search
# rerank_count = "heuristic"  # server-tokenize: exact counts for the split from
#                             # the host's /tokenize (llama.cpp), gated
# efs = 200                   # vector index search breadth 16..1000 (default: ladybug's)
