{
  "name": "ingest-bib",
  "settings": {
    "db_path": "parity/out/ingest-bib-@RUNNER@.db",
    "embedding_dim": 512,
    "model_id": "google/embeddinggemma-2",
    "device": "cuda",
    "precision": "auto"
