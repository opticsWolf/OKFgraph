    {"op": "delete", "params": {"concept_id": "alpha"}},
    {"op": "get_by_id", "params": {"concept_id": "alpha"}},
    {"op": "list_deleted", "params": {}},
    {"op": "recover_deleted", "params": {"concept_id": "alpha"}},
    {"op": "get_by_id", "params": {"concept_id": "alpha"}},
    {"op": "list_deleted", "params": {}},
    {"op": "delete", "params": {"concept_id": "beta"}},
    {"op": "purge_deleted", "params": {"older_than": 0}},
    {"op": "list_deleted", "params": {}}
