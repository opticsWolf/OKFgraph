  "setup": {"import": {"corpus": "parity/corpus/empty"}},
  "ops": [
    {"op": "ingest", "params": {"kind": "bib", "bib_path": "parity/fixtures/parity.bib"}},
    {"op": "get_by_id", "params": {"concept_id": "refs/alpha2020"}}
  ]
}
